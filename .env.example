# Leave empty to use the embedded PGlite database in .data/pglite (local development).
# Set a Postgres connection string in production.
DATABASE_URL=

# First admin account, created by `npm run db:seed` if it does not exist yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public origin of the site, used for absolute links and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Optional. A Hugging Face access token (read) for `npm run assets:shape`. Without it the
# anonymous GPU quota applies, which runs out after a few shapes a day.
HF_TOKEN=
